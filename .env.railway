# ============================================================================
# Cortex Freelancer — Railway Environment Template
# ============================================================================
# Set these in Railway dashboard: Settings → Variables
# Railway provides PORT automatically — do not override it.
# Docs: https://docs.railway.app/reference/variables
# ============================================================================

# ── Runtime (Railway sets PORT automatically) ──
NODE_ENV=production
PLATFORM=railway
DOMAIN=cortex-freelancer-production.up.railway.app

# ── Anthropic AI ──
ANTHROPIC_API_KEY=                       # REQUIRED
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_TIMEOUT_MS=120000

# ── Stripe ──
STRIPE_SECRET_KEY=                       # REQUIRED
STRIPE_WEBHOOK_SECRET=                   # REQUIRED
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_COUPON_LAUNCH50=
STRIPE_COUPON_ANNUAL10=
STRIPE_COUPON_FRIEND20=

# ── Firebase ──
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_SERVICE_ACCOUNT_KEY=           # Base64-encoded JSON

# ── Email ──
RESEND_API_KEY=

# ── Admin ──
ADMIN_TOKEN=                             # REQUIRED
ADMIN_EMAIL=

# ── Notifications ──
SLACK_WEBHOOK_URL=

# ── Monitoring ──
SENTRY_DSN=
GA_MEASUREMENT_ID=

# ── Cron ──
CRON_SECRET=

# ── WebSocket (Railway-optimized) ──
WS_TIMEOUT_PROFILE=production
WS_LOG_LEVEL=info
WS_HEALTH_PING_INTERVAL_MS=25000        # Slightly under Railway's 30s proxy timeout
WS_PONG_TIMEOUT_MS=10000
WS_MAX_MISSED_PONGS=3
WS_SESSION_TIMEOUT_MS=1800000
WS_MAX_CONNECTIONS=200

# ── Load Balancer ──
TRUST_PROXY=true                         # Railway uses reverse proxy
