# ============================================================================
# Cortex Freelancer — Docker Environment Template
# ============================================================================
# Used with docker-compose: docker compose --env-file .env.docker up
# Or copy to .env in the docker/ directory.
# ============================================================================

# ── Runtime ──
NODE_ENV=production
PORT=3847
PLATFORM=docker
DOMAIN=app.cortexfreelancer.com

# ── Anthropic AI ──
ANTHROPIC_API_KEY=                       # REQUIRED
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_TIMEOUT_MS=120000

# ── Stripe ──
STRIPE_SECRET_KEY=                       # REQUIRED
STRIPE_WEBHOOK_SECRET=                   # REQUIRED
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_COUPON_LAUNCH50=
STRIPE_COUPON_ANNUAL10=
STRIPE_COUPON_FRIEND20=

# ── Firebase ──
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_SERVICE_ACCOUNT_KEY=

# ── Email ──
RESEND_API_KEY=

# ── Admin ──
ADMIN_TOKEN=                             # REQUIRED
ADMIN_EMAIL=

# ── Notifications ──
SLACK_WEBHOOK_URL=

# ── Monitoring ──
SENTRY_DSN=
GA_MEASUREMENT_ID=

# ── Cron ──
CRON_SECRET=

# ── WebSocket (Docker/self-hosted) ──
WS_TIMEOUT_PROFILE=production
WS_LOG_LEVEL=info
WS_HEALTH_PING_INTERVAL_MS=30000
WS_PONG_TIMEOUT_MS=10000
WS_MAX_MISSED_PONGS=3
WS_SESSION_TIMEOUT_MS=1800000
WS_MAX_CONNECTIONS=100

# ── SSL (for self-hosted with own certs) ──
SSL_ENABLED=false                        # Set true if terminating TLS in Node
SSL_CERT_PATH=/etc/ssl/certs/cortex.crt
SSL_KEY_PATH=/etc/ssl/private/cortex.key

# ── CDN ──
CDN_URL=
CDN_ENABLED=false

# ── Load Balancer ──
TRUST_PROXY=true                         # Set true if behind nginx/traefik
LB_HEALTH_PATH=/api/health
