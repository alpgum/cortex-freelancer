{
  "name": "cortex-freelancer-redis-queue",
  "version": "1.0.0",
  "description": "Redis Queue System for Cortex Freelancer - CFX-028",
  "main": "src/redis-queue/index.js",
  "scripts": {
    "start": "node src/redis-queue/index.js start",
    "test": "node src/redis-queue/index.js test",
