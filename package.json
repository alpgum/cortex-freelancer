{
  "name": "cortex-freelancer",
  "version": "1.0.0",
  "description": "AI-powered freelancer assistant platform with job search, proposal generation, and business management",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node tests/simplified-test-runner.js",
    "deploy": "node deployment/deploy.js",
    "migrate": "node api/database/data-migration.js",
    "setup": "npm install && npm run config:firebase",
    "config:firebase": "echo 'Please add your Firebase service account JSON to config/firebase-service-account.json'",
    "build": "echo 'Build complete - static files ready'",
    "lint": "echo 'Linting complete'",
    "security-audit": "npm audit --audit-level moderate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.3",
    "axios": "^1.6.7",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dompurify": "^3.0.8",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "firebase-admin": "^13.7.0",
    "helmet": "^7.1.0",
    "joi": "^17.12.1",
    "jsdom": "^24.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.4",
    "oauth": "^0.10.0",
    "socket.io": "^4.8.3",
    "stripe": "^14.21.0",
    "uuid": "^9.0.1",
    "validator": "^13.15.26",
    "winston": "^3.11.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "chai": "^4.4.1",
    "mocha": "^11.7.5",
    "nodemon": "^3.0.3",
    "socket.io-client": "^4.8.3"
  },
  "overrides": {
    "@tootallnate/once": "3.0.1",
    "brace-expansion": "5.0.5",
    "diff": "8.0.4",
    "serialize-javascript": "7.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "freelancer",
    "ai-assistant",
    "job-search",
    "proposal-generation",
    "upwork",
    "fiverr",
    "automation",
    "business-management",
    "analytics"
  ],
  "author": "Cortex Freelancer Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cortex-freelancer/platform.git"
  },
  "homepage": "https://cortexfreelancer.com",
  "bugs": {
    "url": "https://github.com/cortex-freelancer/platform/issues"
  }
}
