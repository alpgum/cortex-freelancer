# ============================================================================
# Cortex Freelancer — Kubernetes Secrets Template
# ============================================================================
# NEVER commit real secrets. Use this as a template:
#   cp secrets.yaml.template secrets.yaml
#   # Fill in values (base64 encoded)
#   kubectl apply -f secrets.yaml
#
# Or use sealed-secrets / external-secrets operator in production.
#
# base64 encode: echo -n 'value' | base64
# ============================================================================

apiVersion: v1
kind: Secret
metadata:
  name: cortex-secrets
  namespace: cortex-freelancer
type: Opaque
data:
  # ── Stripe 🔴 ──
  STRIPE_SECRET_KEY: ""
  STRIPE_WEBHOOK_SECRET: ""
  STRIPE_PRICE_PRO_MONTHLY: ""
  STRIPE_PRICE_PRO_ANNUAL: ""

  # ── Firebase 🔴 ──
  FIREBASE_SERVICE_ACCOUNT_KEY: ""

  # ── AI 🔴 ──
  ANTHROPIC_API_KEY: ""

  # ── Email 🔴 ──
  RESEND_API_KEY: ""

  # ── Admin 🔴 ──
  ADMIN_TOKEN: ""
  ADMIN_EMAIL: ""

  # ── Notifications 🔴 ──
  SLACK_WEBHOOK_URL: ""

  # ── Monitoring 🟡 ──
  SENTRY_DSN: ""

  # ── Cron 🔴 ──
  CRON_SECRET: ""

  # ── Domain 🟡 ──
  DOMAIN: ""

  # ── External Services 🔴 ──
  SCRAPE_DO_API_KEY: ""
  EDGE_API_SECRET: ""
