# ============================================================================
# Cortex Freelancer — Environment Variables Template
# ============================================================================
# Copy this file for your target environment:
#   cp .env.template .env.local              # Local development
#   cp .env.template .env.staging            # Staging
#   cp .env.template .env.production.local   # Production (Docker)
#
# NEVER commit .env files with real values. Only .env.template is tracked.
#
# Sensitivity levels:
#   🔴 SECRET  — API keys, tokens, passwords (rotate regularly)
#   🟡 PRIVATE — Internal config (safe to log server-side)
#   🟢 PUBLIC  — Non-sensitive (can appear in client bundle)
#
# Validate: node config/validate-env.js --report
# Drift:    node config/config-drift.js
# ============================================================================

# ── Runtime 🟢 ──────────────────────────────────────────────────────────────
NODE_ENV=development                          # development | staging | production
PORT=3847                                     # Server port (Railway: 3847, Render: 10000)
PLATFORM=local                                # local | docker | railway | render | vercel | digitalocean
WS_TIMEOUT_PROFILE=development                # development | production | aggressive
DOMAIN=localhost                              # Your domain (e.g., app.cortexfreelancer.com)

# ── Stripe (Payment Processing) 🔴 ──────────────────────────────────────────
# Mock mode activates automatically when STRIPE_SECRET_KEY is absent.
STRIPE_SECRET_KEY=                            # 🔴 sk_test_... or sk_live_...
STRIPE_WEBHOOK_SECRET=                        # 🔴 whsec_...
STRIPE_PRICE_PRO_MONTHLY=                     # 🟡 price_...
STRIPE_PRICE_PRO_ANNUAL=                      # 🟡 price_...
# STRIPE_COUPON_LAUNCH50=                     # 🟡 Optional coupon IDs
# STRIPE_COUPON_ANNUAL10=
# STRIPE_COUPON_FRIEND20=

# ── Firebase 🟢🔴 ───────────────────────────────────────────────────────────
# Client-side config (🟢 PUBLIC — restricted by domain in Firebase console)
FIREBASE_API_KEY=                             # 🟢
FIREBASE_AUTH_DOMAIN=                         # 🟢
FIREBASE_PROJECT_ID=                          # 🟢
FIREBASE_STORAGE_BUCKET=                      # 🟢
FIREBASE_MESSAGING_SENDER_ID=                 # 🟢
FIREBASE_APP_ID=                              # 🟢
# Server-side admin SDK (🔴 SECRET)
FIREBASE_SERVICE_ACCOUNT_KEY=                 # 🔴 Full JSON string, single line

# ── AI (Anthropic Claude) 🔴 ────────────────────────────────────────────────
ANTHROPIC_API_KEY=                            # 🔴 sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514      # 🟢 Model override
# ANTHROPIC_TIMEOUT_MS=120000                  # 🟢 API timeout

# ── Email (Resend) 🔴 ───────────────────────────────────────────────────────
RESEND_API_KEY=                               # 🔴 re_...

# ── Admin 🔴🟡 ──────────────────────────────────────────────────────────────
ADMIN_TOKEN=                                  # 🔴 Min 16 chars — for admin API auth
ADMIN_EMAIL=                                  # 🟡 Admin notification email

# ── Notifications 🔴 ────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=                            # 🔴 https://hooks.slack.com/...

# ── Monitoring 🟡 ───────────────────────────────────────────────────────────
SENTRY_DSN=                                   # 🟡 https://...@sentry.io/...

# ── Analytics 🟢 ────────────────────────────────────────────────────────────
GA_MEASUREMENT_ID=                            # 🟢 G-...

# ── Cron & Edge 🔴 ──────────────────────────────────────────────────────────
CRON_SECRET=                                  # 🔴 Min 16 chars
# EDGE_API_SECRET=                            # 🔴 Vercel edge only

# ── OpenClaw Bridge 🟡 ─────────────────────────────────────────────────────
# OPENCLAW_BACKEND_URL=                       # 🟡 WebSocket URL
# OPENCLAW_SPAWN_TIMEOUT_MS=30000             # 🟢 Spawn timeout

# ── External Services 🔴🟡 ──────────────────────────────────────────────────
# SCRAPE_DO_API_KEY=                          # 🔴 Scrape.do key
# UPWORK_PROXY_URL=                           # 🟡 Proxy for Upwork

