# ============================================================================
# Cortex Freelancer — DigitalOcean App Platform Environment Template
# ============================================================================
# Set these in DO dashboard: App → Settings → App-Level Environment Variables
# Or use doctl: doctl apps update <id> --spec app.yaml
# Docs: https://docs.digitalocean.com/products/app-platform/how-to/use-environment-variables/
# ============================================================================

# ── Runtime ──
NODE_ENV=production
PORT=8080                                # DO App Platform default
PLATFORM=digitalocean
DOMAIN=cortex-freelancer-xxxxx.ondigitalocean.app

# ── Anthropic AI ──
ANTHROPIC_API_KEY=                       # REQUIRED
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_TIMEOUT_MS=120000

# ── Stripe ──
STRIPE_SECRET_KEY=                       # REQUIRED
STRIPE_WEBHOOK_SECRET=                   # REQUIRED
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_COUPON_LAUNCH50=
STRIPE_COUPON_ANNUAL10=
STRIPE_COUPON_FRIEND20=

# ── Firebase ──
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_SERVICE_ACCOUNT_KEY=

# ── Email ──
RESEND_API_KEY=

# ── Admin ──
ADMIN_TOKEN=                             # REQUIRED
ADMIN_EMAIL=

# ── Notifications ──
SLACK_WEBHOOK_URL=

# ── Monitoring ──
SENTRY_DSN=
GA_MEASUREMENT_ID=

# ── Cron ──
CRON_SECRET=

# ── WebSocket (DO-optimized) ──
WS_TIMEOUT_PROFILE=production
WS_LOG_LEVEL=info
WS_HEALTH_PING_INTERVAL_MS=30000
WS_PONG_TIMEOUT_MS=10000
WS_MAX_MISSED_PONGS=3
WS_SESSION_TIMEOUT_MS=1800000
WS_MAX_CONNECTIONS=100

# ── SSL (managed by DO — no manual config needed) ──
SSL_ENABLED=false                        # DO handles TLS termination

# ── Load Balancer ──
TRUST_PROXY=true                         # DO uses reverse proxy
