#!/usr/bin/env python3
"""
Cortex Time CLI - Time Tracking for Freelancers

This is the main CLI entry point for the Cortex Freelancer time tracking system.
All commands are routed to the main time_tracker.py module.

Usage:
    cortex-time start [project] [task]
    cortex-time stop
    cortex-time log [hours] [project] [task] 
    cortex-time status
    cortex-time report [daily|weekly|monthly]
    cortex-time analytics
    cortex-time optimize
"""

import os
import sys
from pathlib import Path

# Add the tools directory to the Python path
script_dir = Path(__file__).parent
tools_dir = script_dir.parent / "tools"
sys.path.insert(0, str(tools_dir))

# Import and run the main time tracker
try:
    from time_tracker import main
    
    if __name__ == '__main__':
        main()
        
except ImportError as e:
    print(f"Error: Could not import time_tracker module: {e}")
    print(f"Make sure the tools/time_tracker.py file exists and is properly configured.")
    sys.exit(1)
except Exception as e:
    print(f"Error running cortex-time: {e}")
    sys.exit(1)