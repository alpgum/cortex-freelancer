{
  "name": "cortex-platform-integration",
  "version": "1.0.0",
  "description": "Comprehensive freelance platform integration with intelligent job matching and opportunity scoring",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "docs": "jsdoc -c jsdoc.json",
    "validate": "node scripts/validate-config.js",
    "demo": "node examples/demo.js"
  },
  "keywords": [
    "freelance",
    "platform-integration",
    "job-matching",
    "opportunity-scoring",
    "upwork",
    "fiverr",
    "freelancer",
    "toptal",
    "automation"
  ],
  "author": "Cortex Freelancer Team",
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.0.0-rc.12",
    "node-fetch": "^3.3.0",
    "events": "^3.3.0"
  },
  "devDependencies": {
    "jest": "^29.0.0",
    "eslint": "^8.0.0",
    "jsdoc": "^4.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "**/*.js",
      "!**/*.test.js",
      "!node_modules/**",
      "!examples/**",
      "!scripts/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 85,
        "lines": 85,
        "statements": 85
      }
    },
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ]
  },
  "eslintConfig": {
    "env": {
      "node": true,
      "es2021": true,
      "jest": true
    },
    "extends": "eslint:recommended",
    "rules": {
      "indent": ["error", 4],
      "linebreak-style": ["error", "unix"],
      "quotes": ["error", "single"],
      "semi": ["error", "always"],
      "no-console": "off",
      "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }]
    }
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cortex-freelancer/platform-integration.git"
  },
  "bugs": {
    "url": "https://github.com/cortex-freelancer/platform-integration/issues"
  },
  "homepage": "https://github.com/cortex-freelancer/platform-integration#readme"
}