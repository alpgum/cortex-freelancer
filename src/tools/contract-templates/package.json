{
  "name": "@cortex-freelancer/contract-templates",
  "version": "1.0.0",
  "description": "Contract Template System with Legal Automation and Risk Assessment",
  "main": "index.js",
  "bin": {
    "contract": "./index.js"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint *.js __tests__/*.js",
    "start": "node index.js",
    "demo": "node demo.js"
  },
  "keywords": [
    "contract",
    "legal",
    "freelancer",
    "template",
    "risk-assessment",
    "automation"
  ],
  "engines": {
    "node": ">=14.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "*.js",
      "!demo.js",
      "!coverage/**"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  },
  "author": "Cortex Freelancer Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cortex-freelancer/contract-templates"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.7.0"
  }
}
