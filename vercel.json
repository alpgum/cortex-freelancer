{
  "version": 2,
  "name": "cortex-freelancer",
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/robots\\.txt",
      "dest": "/server.js"
    },
    {
      "src": "/manifest\\.json",
      "dest": "/server.js"
    },
    {
      "src": "/favicon\\.ico",
      "dest": "/server.js"
    },
    {
      "src": "/sitemap\\.xml",
      "dest": "/server.js"
    },
    {
      "src": "/apple-touch-icon\\.png",
      "dest": "/server.js"
    },
    {
      "src": "/og-image\\.png",
      "dest": "/server.js"
    },
    {
      "src": "/sw\\.js",
      "dest": "/server.js"
    },
    {
      "src": "/service-worker\\.js",
      "dest": "/server.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ],
  "regions": ["iad1"],
  "github": {
    "enabled": false
  }
}
