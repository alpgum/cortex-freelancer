{
  "buildCommand": "",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/check-subscriptions",
      "schedule": "0 0 * * *"
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/app/?$", "dest": "/app/index.html" },
    { "src": "/chat/?$", "dest": "/app/chat.html" },
    { "src": "/app/chat/?$", "dest": "/app/chat.html" },
    { "src": "/login/?$", "dest": "/app/login.html" },
    { "src": "/app/login/?$", "dest": "/app/login.html" },
    { "src": "/tools/invoice/?$", "dest": "/app/tools/invoice.html" },
    { "src": "/tools/proposal/?$", "dest": "/app/tools/proposal.html" },
    { "src": "/tools/rate-calculator/?$", "dest": "/app/tools/rate-calculator.html" },
    { "src": "/tools/fee-calculator/?$", "dest": "/app/tools/fee-calculator.html" },
    { "src": "/tools/contract-review/?$", "dest": "/app/tools/contract-review.html" },
    { "src": "/tools/scope-analyzer/?$", "dest": "/app/tools/scope-analyzer.html" },
    { "src": "/tools/email-writer/?$", "dest": "/app/tools/email-writer.html" },
    { "src": "/tools/payment-checker/?$", "dest": "/app/tools/payment-checker.html" },
    { "src": "/tools/templates/?$", "dest": "/app/tools/templates.html" },
    { "src": "/app/tools/invoice/?$", "dest": "/app/tools/invoice.html" },
    { "src": "/app/tools/proposal/?$", "dest": "/app/tools/proposal.html" },
    { "src": "/app/tools/rate-calculator/?$", "dest": "/app/tools/rate-calculator.html" },
    { "src": "/app/tools/fee-calculator/?$", "dest": "/app/tools/fee-calculator.html" },
    { "src": "/app/tools/contract-review/?$", "dest": "/app/tools/contract-review.html" },
    { "src": "/app/tools/scope-analyzer/?$", "dest": "/app/tools/scope-analyzer.html" },
    { "src": "/app/tools/email-writer/?$", "dest": "/app/tools/email-writer.html" },
    { "src": "/app/tools/payment-checker/?$", "dest": "/app/tools/payment-checker.html" },
    { "src": "/app/tools/templates/?$", "dest": "/app/tools/templates.html" },
    { "src": "/tools/sow-generator/?$", "dest": "/app/tools/sow-generator.html" },
    { "src": "/app/tools/sow-generator/?$", "dest": "/app/tools/sow-generator.html" },
    { "src": "/tools/project-brief/?$", "dest": "/app/tools/project-brief.html" },
    { "src": "/app/tools/project-brief/?$", "dest": "/app/tools/project-brief.html" },
    { "src": "/tools/portfolio-review/?$", "dest": "/app/tools/portfolio-review.html" },
    { "src": "/app/tools/portfolio-review/?$", "dest": "/app/tools/portfolio-review.html" },
    { "src": "/tools/client-red-flags/?$", "dest": "/app/tools/client-red-flags.html" },
    { "src": "/app/tools/client-red-flags/?$", "dest": "/app/tools/client-red-flags.html" },
    { "src": "/support/?$", "dest": "/support.html" },
    { "src": "/pricing/?$", "dest": "/pricing.html" },
    { "src": "/admin/?$", "dest": "/admin.html" },
    { "src": "/checkout-success/?$", "dest": "/checkout-success.html" },
    { "src": "/refund/?$", "dest": "/refund.html" },
    { "src": "/app/referral/?$", "dest": "/app/referral.html" },
    { "src": "/referral/?$", "dest": "/app/referral.html" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/500/?$", "dest": "/500.html" },
    { "src": "/(.*)", "dest": "/404.html", "status": 404 }
  ]
}