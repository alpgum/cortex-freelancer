{
  "buildCommand": "",
  "outputDirectory": ".",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/app/?$", "dest": "/app/index.html" },
    { "src": "/app/tools/rate-calculator/?$", "dest": "/app/tools/rate-calculator.html" },
    { "src": "/pricing/?$", "dest": "/pricing.html" },
    { "src": "/admin/?$", "dest": "/admin.html" },
    { "src": "/checkout-success/?$", "dest": "/checkout-success.html" },
    { "src": "/api/(.*)", "dest": "/api/$1" }
  ]
}