# ============================================================================
# Cortex Freelancer — Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# Loading priority: process.env → .env.local → .env
# NEVER commit .env.local or .env with real secrets!
# ============================================================================

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development                    # development | staging | production
PORT=3847                               # HTTP server port
PLATFORM=local                          # local | railway | render | digitalocean | docker
DOMAIN=localhost                        # Public domain (e.g. app.cortexfreelancer.com)

# ── Anthropic AI ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                       # REQUIRED — sk-ant-... (Claude API key)
ANTHROPIC_MODEL=claude-sonnet-4-20250514     # Model to use for AI features
ANTHROPIC_TIMEOUT_MS=120000              # API request timeout (ms)

# ── Stripe Payments ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=                       # REQUIRED for payments — sk_test_... or sk_live_...
STRIPE_WEBHOOK_SECRET=                   # REQUIRED for webhooks — whsec_...
STRIPE_PRICE_PRO_MONTHLY=               # Stripe Price ID for monthly plan
STRIPE_PRICE_PRO_ANNUAL=                # Stripe Price ID for annual plan
STRIPE_COUPON_LAUNCH50=                  # Coupon ID: 50% launch discount
STRIPE_COUPON_ANNUAL10=                  # Coupon ID: 10% annual discount
STRIPE_COUPON_FRIEND20=                  # Coupon ID: 20% referral discount

# ── Firebase ─────────────────────────────────────────────────────────────────
FIREBASE_API_KEY=                        # Firebase Web API key
FIREBASE_AUTH_DOMAIN=                    # e.g. myapp.firebaseapp.com
FIREBASE_PROJECT_ID=                     # e.g. myapp-12345
FIREBASE_STORAGE_BUCKET=                # e.g. myapp-12345.appspot.com
FIREBASE_MESSAGING_SENDER_ID=           # FCM sender ID
FIREBASE_APP_ID=                         # Firebase App ID
FIREBASE_SERVICE_ACCOUNT_KEY=           # Base64-encoded service account JSON (for server-side)

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=                          # re_... (Resend API key)

# ── Admin ────────────────────────────────────────────────────────────────────
ADMIN_TOKEN=                             # REQUIRED — Token for admin endpoints
ADMIN_EMAIL=                             # Admin notification email

# ── Notifications ────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=                       # Slack incoming webhook for alerts

# ── Monitoring ───────────────────────────────────────────────────────────────
SENTRY_DSN=                              # Sentry error tracking DSN
GA_MEASUREMENT_ID=                       # Google Analytics 4 measurement ID

# ── Cron ─────────────────────────────────────────────────────────────────────
CRON_SECRET=                             # Secret for cron endpoint auth

# ── External Services ───────────────────────────────────────────────────────
UPWORK_PROXY_URL=                        # Proxy URL for Upwork job scraping
SCRAPE_DO_API_KEY=                       # Scrape.do API key
EDGE_API_SECRET=                         # Edge function auth secret

# ── OpenClaw Bridge (local mode only) ────────────────────────────────────────
OPENCLAW_BACKEND_URL=                    # OpenClaw gateway URL (local dev)
OPENCLAW_SPAWN_TIMEOUT_MS=30000         # CLI spawn timeout (ms)

# ── WebSocket Configuration ─────────────────────────────────────────────────
WS_TIMEOUT_PROFILE=production            # development | production | aggressive
WS_LOG_LEVEL=info                        # debug | info | warn | error
WS_PROCESSING_KEEPALIVE_MS=5000         # Keepalive ping during AI processing (ms)
WS_HEALTH_PING_INTERVAL_MS=30000        # Health check ping interval (ms)
WS_PONG_TIMEOUT_MS=10000                # Max wait for pong response (ms)
WS_MAX_MISSED_PONGS=3                   # Disconnect after N missed pongs
WS_STALE_CONNECTION_MS=300000           # Mark connection stale after (ms)
WS_HEALTH_LOG_INTERVAL_MS=60000         # Health stats logging interval (ms)
WS_CLEANUP_INTERVAL_MS=60000            # Dead connection cleanup interval (ms)
WS_CONNECTION_TIMEOUT_MS=30000          # Initial connection timeout (ms)
WS_SESSION_TIMEOUT_MS=1800000           # Max session duration (ms, 30min default)
WS_MAX_CONNECTIONS=100                   # Max concurrent WebSocket connections

# ── SSL/TLS (self-hosted only) ───────────────────────────────────────────────
SSL_ENABLED=false                        # Enable HTTPS
SSL_CERT_PATH=                           # Path to SSL certificate
SSL_KEY_PATH=                            # Path to SSL private key
SSL_CA_PATH=                             # Path to CA bundle (optional)

# ── CDN ──────────────────────────────────────────────────────────────────────
CDN_URL=                                 # CDN base URL for static assets
CDN_ENABLED=false                        # Enable CDN asset rewriting

# ── Load Balancer ────────────────────────────────────────────────────────────
TRUST_PROXY=false                        # Trust X-Forwarded-* headers
LB_HEALTH_PATH=/api/health               # Health check endpoint path
