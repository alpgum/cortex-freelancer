# Cortex Freelancer — Environment Variables
# Copy this file to .env and fill in your values

# Stripe (Test Mode)
# Get your keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Stripe Price IDs — create products at https://dashboard.stripe.com/test/products
# Product: Cortex Freelancer Pro
# Price 1: $29/month recurring
STRIPE_PRICE_PRO_MONTHLY=price_REPLACE_ME
# Price 2: $249/year recurring
STRIPE_PRICE_PRO_ANNUAL=price_REPLACE_ME

# Stripe Coupon IDs (optional — for /api/apply-coupon)
# Create coupons at https://dashboard.stripe.com/test/coupons
# STRIPE_COUPON_LAUNCH50=coupon_REPLACE_ME
# STRIPE_COUPON_FRIEND20=coupon_REPLACE_ME
# STRIPE_COUPON_ANNUAL10=coupon_REPLACE_ME

# Admin
# Token for manual Pro unlock via /api/toggle-pro and /api/export-events
ADMIN_TOKEN=cortex-admin-2026
# Email address for daily metrics reports
ADMIN_EMAIL=you@example.com

# Firebase — Client-side config (from Firebase Console > Project Settings > Your apps)
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# Firebase — Server-side service account (from Firebase Console > Project Settings > Service accounts)
# Generate a new private key JSON, then base64-encode it:
#   base64 -i service-account.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_KEY=BASE64_ENCODED_SERVICE_ACCOUNT_JSON

# Anthropic (Claude AI chat feature)
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Cron job authentication (Vercel Cron)
# Used by /api/cron/* endpoints — set to a secure random string
CRON_SECRET=REPLACE_ME

# Resend (Transactional Email — free tier: 100 emails/day)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_REPLACE_ME

# Slack (Revenue Notifications — optional)
# Create an Incoming Webhook at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME/HERE

# Sentry (Error Monitoring — optional, free tier)
# Get your DSN from https://sentry.io → Project Settings → Client Keys (DSN)
SENTRY_DSN=https://YOUR_KEY@YOUR_ORG.ingest.sentry.io/YOUR_PROJECT_ID

# Google Analytics (GA4 — client-side only)
# Get your Measurement ID from https://analytics.google.com → Admin → Data Streams
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Domain (optional — used for Stripe success/cancel URLs)
# DOMAIN=https://cortexfreelancer.com
