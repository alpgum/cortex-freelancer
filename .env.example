# Cortex Freelancer Environment Configuration
# Copy this file to .env and fill in your actual values

# Firebase Configuration
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# AI Services
ANTHROPIC_API_KEY=sk-ant-api03-your_anthropic_key
OPENAI_API_KEY=sk-your_openai_key

# External Platform APIs
UPWORK_CONSUMER_KEY=your_upwork_consumer_key
UPWORK_CONSUMER_SECRET=your_upwork_consumer_secret
FIVERR_API_KEY=your_fiverr_api_key

# Email Services
GMAIL_CLIENT_ID=your_gmail_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REDIRECT_URI=http://localhost:3000/auth/gmail/callback

# Payment Processing
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Security
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
ENCRYPTION_KEY=your_encryption_key_exactly_32_characters
SESSION_SECRET=your_session_secret_minimum_64_characters

# Application Configuration
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3849

# Database
DATABASE_URL=your_database_connection_string

# Analytics & Monitoring
GOOGLE_ANALYTICS_ID=GA4-your_analytics_id
SENTRY_DSN=https://your_sentry_dsn

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false

# External Services
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook/url

# Feature Flags
ENABLE_AI_FEATURES=true
ENABLE_ANALYTICS=true
ENABLE_PAYMENTS=true
ENABLE_EMAIL_AUTOMATION=true
ENABLE_RATE_LIMITING=true

# Development & Testing
DEBUG=cortex:*
LOG_LEVEL=info
MOCK_EXTERNAL_APIS=false